# Copy to .env and edit. Everything is optional.
# SECRET_KEY=change-me                 # otherwise generated once into instance/secret.key
# DATABASE_URL=sqlite:///instance/hacknetix.db
# MODEL_ROOT=                          # defaults to ../ai_model/models/hacknetix_sentence_transformer; relative paths use backend/
# MODEL_ZIP=                           # optional explicit model zip path; relative paths use backend/
# SIMILARITY_THRESHOLD=                # existing default is 0.60; not calibrated for the fine-tuned model
# MAX_SUGGESTIONS=5
# COOKIE_SECURE=1                      # set when served over HTTPS
# ALLOW_FALLBACK_EMBEDDER=0            # 1 = dev-only stand-in when the model is missing (not the HACKNETIX model)
